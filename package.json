{
  "name": "nonstopvibin",
  "version": "0.3.1",
  "updatesEnabled": true,
  "description": "A local desktop proxy for using AI subscriptions with coding agents.",
  "private": true,
  "homepage": "https://github.com/samuelfarkas/nonstopvibin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samuelfarkas/nonstopvibin.git"
  },
  "bugs": {
    "url": "https://github.com/samuelfarkas/nonstopvibin/issues"
  },
  "type": "module",
  "engines": {
    "bun": ">=1.4.2"
  },
  "scripts": {
    "dev": "bun scripts/dev.mjs",
    "start": "cargo build -p nsv-window && cargo run -p nsv-cli --bin nonstopvibin",
    "core:install": "bun run core:tool install",
    "core:pin": "bun run core:tool pin",
    "core:tool": "cargo run --quiet --locked -p nsv-core --example core-tool --",
    "check": "tsc --noEmit",
    "test": "bun test && sh scripts/cargo.sh test --locked",
    "test:ui": "sh crates/window/tests/ui.sh --locked",
    "test:shell": "sh crates/shell/tests/gui.sh --locked",
    "test:server": "bun tests/server-archive-smoke.mjs",
    "build": "bun run build:client && cargo build --release --locked",
    "build:client": "bun run check && vite build && bun scripts/third-party.mjs",
    "dist:mac": "bun run build:client && bun scripts/package-mac.ts",
    "dist:linux": "bun run build:client && bun scripts/package-linux.ts",
    "dist:server": "bun run build:client && bun scripts/package-server.ts",
    "test:update:mac": "bun tests/mac-update.mjs && bun tests/mac-update-rust.mjs",
    "test:update:linux": "sh tests/linux-update.sh",
    "test:desktop:mac": "bun tests/mac-desktop.mjs",
    "server:deploy": "bun scripts/server-remote.mjs deploy",
    "server:open": "bun scripts/server-remote.mjs open",
    "format": "oxfmt src tests scripts *.json *.ts index.html .github .vscode .oxlintrc.json .oxfmtrc.json",
    "lint": "oxlint . --max-warnings 0",
    "quality": "bun run check && bun run lint && bun run format:check && bun run registry:check && bun scripts/verify-release.mjs && cargo fmt --all --check && sh scripts/cargo.sh clippy --all-targets --locked -- -D warnings && RUSTDOCFLAGS='-D warnings' sh scripts/cargo.sh doc --no-deps --locked && bun run wire:check",
    "security:deps": "bun audit --audit-level=high",
    "security:scan": "bun run --cwd .deepsec scan",
    "security:report": "bun run --cwd .deepsec report",
    "setup": "bun ci && bun run core:install",
    "security:install": "bun scripts/install-security-tools.mjs",
    "security:secrets": ".vendor/security/gitleaks dir . --config .gitleaks-source.toml --redact --no-banner",
    "security:history": "git rev-parse --verify HEAD >/dev/null && .vendor/security/gitleaks git . --config .gitleaks.toml --redact --no-banner --log-opts=--all",
    "security:tooling": "bun run --cwd .deepsec audit",
    "icons": "bun scripts/icons.mjs",
    "registry:export": "bun scripts/export-registry.ts",
    "registry:check": "bun scripts/export-registry.ts --check",
    "wire:export": "cargo test -p nsv-domain -p nsv-desktop --locked --lib write_generated_typescript -- --ignored",
    "wire:check": "cargo test -p nsv-domain -p nsv-desktop --locked --lib generated_typescript_matches",
    "format:check": "bun run format --check"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-select": "2.3.7",
    "lucide-react": "1.41.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.94.0",
    "@types/node": "24.13.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "js-yaml": "4.3.2",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "sharp": "0.35.5",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "author": "nonstopvibin",
  "license": "MIT",
  "packageManager": "bun@1.4.2"
}
