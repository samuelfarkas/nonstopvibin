{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "sortPackageJson": false,
  "ignorePatterns": [
    "node_modules/",
    "dist/",
    "release/",
    ".vendor/",
    ".codex/",
    ".claude/",
    "test-results/",
    ".runtime/",
    ".test-runtime/",
    ".deepsec/",
    ".agents/",
    "tools/oxlint/anti-slop/",
    "tests/fixtures/ts-data-dir/data/",
    "tests/fixtures/ts-data-dir/agent-home/",
    "tests/types/generated/",
    "tests/golden/*.json"
  ]
}
